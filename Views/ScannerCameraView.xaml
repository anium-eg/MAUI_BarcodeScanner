<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_BarcodeScanner.Views.ScannerCameraView"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             xmlns:vm="clr-namespace:MAUI_BarcodeScanner.ViewModels"
             x:DataType="vm:ScannerCameraViewModel"
             Title="Barcode Scanner">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Stop" Command="{Binding GoBackCommand}"/>
    </ContentPage.ToolbarItems>
    <scanner:CameraView OnDetectionFinishedCommand="{Binding BarcodeDetectedCommand}" CameraFacing="Back" CameraEnabled="True" />
</ContentPage>