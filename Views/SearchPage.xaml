<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAUI_BarcodeScanner.Views.SearchPage"
    xmlns:vm="clr-namespace:MAUI_BarcodeScanner.ViewModels"
    xmlns:model="clr-namespace:MAUI_BarcodeScanner.Models"
    x:DataType="vm:SearchViewModel"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Search">
    <VerticalStackLayout>
        <SearchBar 
            Text="{Binding SearchTerm, Mode=TwoWay}" 
            Placeholder="Search Product Name or SKU ID..."
            TextChanged="SearchBar_TextChanged"
            SearchCommand="{Binding SearchCommand}">
            <!--
            Event to command behaviour is not binding
            <SearchBar.Behaviors>
                <toolkit:EventToCommandBehavior
                    EventName="TextChanged"
                    Command="{Binding SearchCommand}"/>
            </SearchBar.Behaviors>
            -->
        </SearchBar>
        <CollectionView 
            x:Name="InventoryItems"
            ItemsSource="{Binding InventoryItems}" 
            Margin="10"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No items in the inventory"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:InventoryItem">
                    <VerticalStackLayout>
                        <Border Margin="1">
                            <Grid 
                                RowDefinitions="*,*" 
                                ColumnDefinitions="3.5*,*,*"
                                Padding="30">
                                <Label 
                                Text="{Binding ProductName}"
                                FontSize="Medium"
                                FontAttributes="Bold"
                                Grid.Row="0"/>
                                <Label 
                                Text="{Binding SKUId, StringFormat='SKU ID: {0}'}" 
                                Grid.Row="1"/>
                                <Label
                                    Grid.Column="1"
                                    Grid.RowSpan="2"
                                    HorizontalTextAlignment="Start"
                                    VerticalTextAlignment="Center"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    Text="{Binding Price, StringFormat='$ {0}'}"
                                />
                            
                                <Button 
                                    Grid.Column="2"
                                    Grid.RowSpan="2"
                                    WidthRequest="50"
                                    HorizontalOptions="End"
                                    FontSize="Large"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=AddToCartCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="+"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>