<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_BarcodeScanner.Components.MopupDetailSheet"
             xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
             xmlns:vm="clr-namespace:MAUI_BarcodeScanner.ViewModels"
             xmlns:converters="clr-namespace:MAUI_BarcodeScanner.Helpers.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="MopupDetailSheet"
             BackgroundColor="#80000000"
             CloseWhenBackgroundIsClicked="{Binding CanCloseBottomSheet}"
             BackgroundClickedCommand="{Binding BackgroundClickedCommand}"
             x:DataType="vm:MopupDetailSheetViewModel"
             TranslationY="{Binding YOffset}"
             >

    <mopups:PopupPage.Resources>
        <ResourceDictionary>
            <converters:TextChangedEventParameterConverter x:Key="TextChangedEventParameterConverter"/>
            <converters:BooleanNegationConverter x:Key="BoolNegationConverter"/>
        </ResourceDictionary>
    </mopups:PopupPage.Resources>
    
    <mopups:PopupPage.Animation>
        <animations:MoveAnimation
            PositionIn="Bottom"/>
    </mopups:PopupPage.Animation>

    
    <Border  
        VerticalOptions="End"

        >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20,20,0,0"/>
        </Border.StrokeShape>
        <VerticalStackLayout     
            Background="White"
            Spacing="16"  
            Padding="30"
         >
            <Label Text="{Binding CurrentItem.ProductName}" FontSize="Large" FontAttributes="Bold"/>

                <HorizontalStackLayout >
                    <VerticalStackLayout HorizontalOptions="Start">
                        <Label Text="SKU ID" FontAttributes="Bold" FontSize="Small" />
                        <Label Text="{Binding CurrentItem.SKUId}" FontSize="Small"/>
                        <Label Text="MRP"  FontAttributes="Bold" FontSize="Small"  Margin="0,10,0,0"/>
                        <Label Text="{Binding CurrentItem.MRP,StringFormat='$ {0}'}"/>
                        <Label Text="Price"  FontAttributes="Bold" FontSize="Small"  Margin="0,10,0,0"/>
                        <HorizontalStackLayout>
                            <Label VerticalOptions="Center">$</Label>
                        <Entry x:Name="PriceEntry" Text="{Binding PricePerItem}" WidthRequest="100">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    EventName="Focused"
                                    Command="{Binding KeyboardFocusedCommand}"
                                    BindingContext="{Binding Source={x:Reference PriceEntry}, Path=BindingContext}" />
                                    
                                <toolkit:EventToCommandBehavior
                                    EventName="Unfocused"
                                    Command="{Binding KeyboardUnfocusedCommand}"
                                    BindingContext="{Binding Source={x:Reference PriceEntry}, Path=BindingContext}"/>
                            </Entry.Behaviors>
                        </Entry>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                    <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="End" Margin="30,0,0,0">
                        <Label Text="Quantity"  FontAttributes="Bold" FontSize="Small" />
                        <HorizontalStackLayout Margin="0,10,0,0">
                            <Button Text="-" Command="{Binding DecreaseQuantityCommand}" WidthRequest="3" HeightRequest="3" FontSize="20"/>
                            <Label Text="{Binding CurrentItem.Quantity}" FontSize="Medium" VerticalOptions="Center" Margin="10"/>
                            <Button Text="+" WidthRequest="3" HeightRequest="3" FontSize="20" Command="{Binding IncreaseQuantityCommand}"/>
                        </HorizontalStackLayout>
                        <Label Text="Total Price"  FontAttributes="Bold" FontSize="Small"  Margin="0,10,0,0"/>
                        <Label Text="{Binding CurrentItem.TotalPrice,StringFormat='$ {0}'}" FontSize="Large" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Label TextColor="IndianRed" Text="{Binding InvalidPriceMessage}" IsVisible="{Binding IsPriceInvalid}"/>
            <Grid
                
                ColumnDefinitions="*,*"
                ColumnSpacing="5"
                >
                <Button Text="Remove Item" FontSize="Small" BackgroundColor="IndianRed" HeightRequest="2" Margin="0,10,0,0" Command="{Binding DeleteItemCommand }" Grid.Column="0"></Button>
                <Button Text="Close" FontSize="Small"  HeightRequest="2" Margin="0,10,0,0" Command="{Binding CloseBottomSheetCommand }" Grid.Column="1"></Button>
            </Grid>
        </VerticalStackLayout>
    </Border>

</mopups:PopupPage>